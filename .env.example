# ─────────────────────────────────────────────────────────────────────────────
# FoodLoop AI — environment template
#
# ⚠️ SECURITY RULE: everything prefixed with VITE_ is PUBLIC.
#    It gets compiled into the JS bundle and is visible to anyone.
#    NEVER put API keys, secrets, tokens or passwords in this file.
#    Server-side secrets belong in the backend's environment (not in Git),
#    and the front end must only ever talk to the backend over HTTPS.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin used for <link rel="canonical">, sitemap and OG URLs.
# GitHub Pages default: https://codewithshubham2706.github.io
VITE_SITE_URL=https://codewithshubham2706.github.io

# Deploy base path WITHOUT trailing slash. Empty ('') for root deploys and
# local dev; '/FoodLoop-AI' for the GitHub Pages project-site deploy. CI sets
# this via the VITE_BASE_PATH build env var (see .github/workflows/ci.yml).
VITE_BASE_PATH=

# Google Analytics 4 MEASUREMENT ID (a public identifier, not a secret).
# Leave empty to run analytics in no-op stub mode.
VITE_GA4_MEASUREMENT_ID=

# Public contact email shown in the footer and legal pages.
VITE_CONTACT_EMAIL=hello@foodloop.ai
