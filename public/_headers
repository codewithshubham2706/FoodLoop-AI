# Security & privacy headers for static hosts (Netlify, Cloudflare Pages).
# Force HTTPS: http → https, HSTS with 2-year max-age, preload-ready.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Long-cache immutable hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the HTML shell (so deploys propagate instantly)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
